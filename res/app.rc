#include <windows.h>
#include "..\\src\\version.h"

// 应用图标，用于 exe 和任务栏。
1 ICON "app.ico"
// 托盘图标，资源 2 为浅色任务栏使用的黑色图标，资源 3 为深色任务栏使用的白色图标。
2 ICON "tray\\A-black.ico"
3 ICON "tray\\A-white.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FLIPROW_VERSION_MAJOR,FLIPROW_VERSION_MINOR,FLIPROW_VERSION_PATCH,0
 PRODUCTVERSION FLIPROW_VERSION_MAJOR,FLIPROW_VERSION_MINOR,FLIPROW_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 BEGIN
   BLOCK "StringFileInfo"
   BEGIN
     BLOCK "040904b0"
     BEGIN
       VALUE "FileDescription", "FlipRow"
       VALUE "FileVersion", FLIPROW_VERSION_FILE_STRING
       VALUE "InternalName", "FlipRow"
       VALUE "LegalCopyright", "Copyright (c) 2026 RiBunsyou"
       VALUE "OriginalFilename", "FlipRow.exe"
       VALUE "ProductName", "FlipRow"
       VALUE "ProductVersion", FLIPROW_VERSION_FILE_STRING
     END
   END
   BLOCK "VarFileInfo"
   BEGIN
     VALUE "Translation", 0x409, 1200
   END
 END
